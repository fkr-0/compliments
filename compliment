add_completion_from_command() {
  local cmd="$1"
  local name="$2"
  local type="${3:-${COMPL_SHELL:-$(get_shell_type)}}"
  local completion_dir

  completion_dir="$(get_completion_dir "$type")"
  log "DEBUG" "Adding command output to completion directory: $completion_dir"

  # Create completion directory if it doesn't exist
  if [ ! -d "$completion_dir" ]; then
    mkdir -p "$completion_dir"
    log "INFO" "Created completion directory: $completion_dir"
  fi

  if [ "$cmd" == "-" ]; then
    cat >"$completion_dir/$name"
  else
    # Safer command execution with error checking does not work unfortunately(?)
    # if bash -c $(printf "%q" "$cmd") >"$completion_dir/$name"; then
    if bash -c "$cmd" >"$completion_dir/$name"; then
      log "INFO" "Added completion script '$name' from command to $completion_dir"
    else
      log "ERROR" "Failed to execute command: $cmd"
      log "ERROR" "$(ls -l "$(dirname "$cmd")" 2>/dev/null || echo "Command directory not accessible")"
      return 1
    fi
  fi
}

add_completion_from_stdin() {
  local name="$1"
  local type="${2:-${COMPL_SHELL:-$(get_shell_type)}}"
  local completion_dir

  completion_dir="$(get_completion_dir "$type")"
  log "DEBUG" "Adding completion script to $completion_dir from stdin"

  # Create completion directory if it doesn't exist
  if [ ! -d "$completion_dir" ]; then
    mkdir -p "$completion_dir"
    log "INFO" "Created completion directory: $completion_dir"
  fi

  # Read from stdin and write to the completion script file
  cat >"$completion_dir/$name"
  log "INFO" "Added completion script '$name' from stdin to $completion_dir"
}

remove_completion() {
  local name="$1"
  local type="${2:-${COMPL_SHELL:-$(get_shell_type)}}"
  local completion_dir

  completion_dir="$(get_completion_dir "$type")"

  if [ -f "$completion_dir/$name" ]; then
    rm "$completion_dir/$name"
    log "INFO" "Removed completion script '$name' from $completion_dir"
  else
    log "ERROR" "Completion script '$name' not found in $completion_dir"
    return 1
  fi
}

list_completions() {
  local type="${1:-${COMPL_SHELL:-$(get_shell_type)}}"
  local completion_dir

  # If no type specified, check if specific completion dirs are set in environment
  if [ -z "${1:-}" ]; then
    # If both BASH_COMPLETION_DIR and ZSH_COMPLETION_DIR are set, check both
    if [ -n "${BASH_COMPLETION_DIR:-}" ] && [ -d "$BASH_COMPLETION_DIR" ] && [ -n "$(ls -A "$BASH_COMPLETION_DIR" 2>/dev/null)" ]; then
      ls -1 "$BASH_COMPLETION_DIR"
    fi
    if [ -n "${ZSH_COMPLETION_DIR:-}" ] && [ -d "$ZSH_COMPLETION_DIR" ] && [ -n "$(ls -A "$ZSH_COMPLETION_DIR" 2>/dev/null)" ]; then
      ls -1 "$ZSH_COMPLETION_DIR"
    fi
    return 0
  fi

  completion_dir="$(get_completion_dir "$type")"

  if [ -d "$completion_dir" ] && [ -n "$(ls -A "$completion_dir" 2>/dev/null)" ]; then
    ls -1 "$completion_dir"
  else
    log "INFO" "No completions found in $completion_dir"
  fi
}
# Main function
main() {
  local COMPL_SHELL
  COMPL_SHELL="$(get_shell_type)"
  local CONF_DIR
  CONF_DIR="$(get_config_dir "$COMPL_SHELL")"
  local COMPLETION_DIR
  COMPLETION_DIR="$(get_completion_dir "$COMPL_SHELL")"
  local RC_FILE
  RC_FILE="$(get_rc_file "$COMPL_SHELL")"
  local is_completion_mode=0
  local first_arg="$1" # Save first argument before any shifting

  if [ "$#" -eq 0 ] && [ ! -t 0 ]; then
    handle_piped_stdin
    exit $?
  fi

  # Handle completion mode first - no logging needed
  if [ "$first_arg" = "completion" ]; then
    if [ -n "${2:-}" ]; then
      is_completion_mode=1
      generate_completion_script "$2"
      exit 0
    else
      echo "Error: Argument for completion is missing. Use 'bash' or 'zsh'." >&2
      exit 1
    fi
  fi

  log "INFO" "Shell Type: ${COMPL_SHELL}"
  log "INFO" "RC File: ${RC_FILE}"
  log "INFO" "Config Directory: ${CONF_DIR}"
  log "INFO" "Completion Directory: ${COMPLETION_DIR}"
  log "INFO" "Completion Directory exists: \
    $(if [ -d "$COMPLETION_DIR" ]; then echo "yes"; else echo "no"; fi)"

  local shell_type
  shell_type="$(get_shell_type)"

  while (("$#")); do
    case "$1" in
    --file)
      shift # Consume the argument
      if [ -n "$1" ] && [ -f "$1" ]; then
        add_completion_from_file "$1" "" "$shell_type"
      else
        echo "Error: Argument for --file is missing or not a file"
        exit 1
      fi
      ;;
    --command)
      shift # Consume the argument
      if [ -n "$1" ] && [ -n "${2:-}" ]; then
        add_completion_from_command "$1" "$2" "$shell_type"
        shift # Consume the next argument
      else
        echo "Error: Arguments for --command are missing or invalid"
        exit 1
      fi
      ;;
    --stdin)
      shift # Consume the argument
      if [ -n "$1" ]; then
        add_completion_from_stdin "$1" "$shell_type"
      else
        log "ERROR" "Argument for --stdin is missing"
        exit 1
      fi
      ;;
    --status)
      show_status
      ;;
    completion)
      if [ -n "${2:-}" ]; then
        generate_completion_script "$2"
        exit 0
      else
        echo "Error: Argument for completion is missing. Use 'bash' or 'zsh'." >&2
        exit 1
      fi
      ;;
    --reload)
      reload_completions "$shell_type"
      ;;
    --remove)
      shift # Consume the argument
      if [ -n "$1" ]; then
        remove_completion "$1" "$shell_type"
      else
        echo "Error: Argument for --remove is missing"
        exit 1
      fi
      ;;
    --list)
      # If specific completion directories are set in environment, use them
      if [ -n "${BASH_COMPLETION_DIR:-}" ] && [ -n "${ZSH_COMPLETION_DIR:-}" ]; then
        # Both are set, list both
        list_completions
      elif [ -n "${BASH_COMPLETION_DIR:-}" ]; then
        # Only BASH_COMPLETION_DIR is set, use bash
        list_completions "bash"
      elif [ -n "${ZSH_COMPLETION_DIR:-}" ]; then
        # Only ZSH_COMPLETION_DIR is set, use zsh
        list_completions "zsh"
      else
        # Use detected shell type
        list_completions "$shell_type"
      fi
      ;;
    --lint)
      if [ "${2:-}" ]; then
        lint_completions "$2"
        exit 0
      else
        lint_completions "$(get_shell_type)"
        exit 0
      fi
      ;;
    --chsh)
      if [ -n "${2:-}" ]; then
        shell_type="$2"
        _SHELL_TYPE="$2"
        COMPL_SHELL="$2"
        # Update configuration variables for the new shell
        CONF_DIR="$(get_config_dir "$COMPL_SHELL")"
        COMPLETION_DIR="$(get_completion_dir "$COMPL_SHELL")"
        RC_FILE="$(get_rc_file "$COMPL_SHELL")"
        log "INFO" "Shell type changed to: ${COMPL_SHELL}"
        shift # Consume the argument value
      else
        echo "Error: Argument for --chsh is missing"
        exit 1
      fi
      ;;
    *)
      echo "Error: Invalid option $1"
      echo ""
      usage
      exit 1
      ;;
    esac
    shift # Always shift at the end of the loop
  done

  # Only call ensure_completion_loaded if not in a test environment and not generating completion script
  if [ -z "${BATS_TEST_FILENAME:-}" ] && [ "$is_completion_mode" -eq 0 ]; then
    ensure_completion_loaded "$COMPL_SHELL" "$RC_FILE"
  fi
}

# Only execute main when not sourced
if ! sourced_p; then
  if [ "$#" -gt 0 ]; then
    main "$@"
  else
    usage
    exit 1
  fi
fi
