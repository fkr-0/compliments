#!/usr/bin/env bash
set -euo pipefail

# Global color variables
_GREEN="\033[0;32m"
_RED="\033[0;31m"
_YELLOW="\033[0;33m"
_BLUE="\033[0;34m"
_RESET="\033[0m"
_BOLD="\033[1m"
_UNDERLINE="\033[4m"
DEBUG=1

declare _SHELL_TYPE
declare _SHELL_CONF_DIR
declare _SHELL_COMPLETION_DIR
declare _SHELL_RC_FILE
declare _BASH_CONF_DIR_CACHE=""
declare _ZSH_CONF_DIR_CACHE=""
declare _BASH_RC_FILE_CACHE=""
declare _ZSH_RC_FILE_CACHE=""
declare _BASH_COMPLETION_DIR_CACHE=""
declare _ZSH_COMPLETION_DIR_CACHE=""
declare _LAST_COMPLETION_FILE=""

get_shell_type() {
  if [ -n "${_SHELL_TYPE:-}" ]; then
    echo "$_SHELL_TYPE"
    return 0
  fi

  # When script is executed directly (not sourced), use SHELL environment variable
  # This inherits the login shell from the parent environment, cleaner than /etc/passwd
  if ! sourced_p; then
    if [ -n "${SHELL:-}" ]; then
      _SHELL_TYPE="$(basename "$SHELL")"
    else
      # Fallback to checking /etc/passwd for login shell
      _SHELL_TYPE="$(grep -Po "^$USER:.*:[^:]*/\K[^/]*$" /etc/passwd 2>/dev/null || echo "bash")"
    fi
    # When sourced, check the current shell environment
  elif [ -n "${BASH:-}" ]; then
    _SHELL_TYPE="bash"
  elif [ -n "${ZSH_VERSION:-}" ]; then
    _SHELL_TYPE="zsh"
  else
    # Fall back to checking /etc/passwd for login shell
    _SHELL_TYPE="$(grep -Po "^$USER:.*:[^:]*/\K[^/]*$" /etc/passwd 2>/dev/null || echo "bash")"
  fi
  echo "$_SHELL_TYPE"
}

zsh_conf_dir() {
  # local lnk="$(find "$HOME" -maxdepth 1 -type l -printf "%f\n" | grep "\.zsh")"
  local ZDOTDIR
  ZDOTDIR="$(zsh -c 'echo $ZDOTDIR')"
  ZDOTDIR="${ZDOTDIR:-~/.zsh}"
  if [ -d "$ZDOTDIR" ]; then
    echo "$ZDOTDIR"
    return 0
  fi
  if [ -f ~/.zshrc ]; then
    readlink -f ~/.zshrc | xargs dirname
    return 0
  fi

  if [ -f ~/.zshenv ]; then
    readlink -f ~/.zshenv | xargs dirname
    return 0
  fi
  return 1
}

bash_conf_dir() {
  if [ -f ~/.bashrc ]; then
    readlink -f ~/.bashrc | xargs dirname
    return 0
  fi

  if [ -f ~/.bash_profile ]; then
    readlink -f ~/.bash_profile | xargs dirname
    return 0
  fi
  return 1
}

get_config_dir() {
  local shell_type="$1"

  if [ "$shell_type" == "zsh" ]; then
    if [ -n "${_ZSH_CONF_DIR_CACHE:-}" ]; then
      echo "$_ZSH_CONF_DIR_CACHE"
      return 0
    fi
    _ZSH_CONF_DIR_CACHE="$(zsh_conf_dir)"
    if [ $? -ne 0 ] || [ -z "$_ZSH_CONF_DIR_CACHE" ]; then
      # Return error if zsh config directory cannot be found
      return 1
    fi
    echo "$_ZSH_CONF_DIR_CACHE"
  else
    if [ -n "${_BASH_CONF_DIR_CACHE:-}" ]; then
      echo "$_BASH_CONF_DIR_CACHE"
      return 0
    fi
    _BASH_CONF_DIR_CACHE="$(bash_conf_dir)"
    if [ $? -ne 0 ] || [ -z "$_BASH_CONF_DIR_CACHE" ]; then
      # Return error if bash config directory cannot be found
      return 1
    fi
    echo "$_BASH_CONF_DIR_CACHE"
  fi
}

get_rc_file() {
  local shell_type="$1"
  local ZDOTDIR
  ZDOTDIR="$(zsh -c 'echo $ZDOTDIR' 2>/dev/null || echo)"

  if [ "$shell_type" == "zsh" ]; then
    if [ -n "${_ZSH_RC_FILE_CACHE:-}" ]; then
      echo "$_ZSH_RC_FILE_CACHE"
      return 0
    fi
    if [ -d "$ZDOTDIR" ] && [ -f "$ZDOTDIR/.zshrc" ]; then
      _ZSH_RC_FILE_CACHE="$(readlink -f "$ZDOTDIR/.zshrc")"
      echo "$_ZSH_RC_FILE_CACHE"
      return 0
    fi
    if [ -f ~/.zshrc ]; then
      _ZSH_RC_FILE_CACHE="$(readlink -f ~/.zshrc)"
      echo "$_ZSH_RC_FILE_CACHE"
      return 0
    fi
    log "ERROR" "Zsh config file not found"
    return 1
  else
    if [ -n "${_BASH_RC_FILE_CACHE:-}" ]; then
      echo "$_BASH_RC_FILE_CACHE"
      return 0
    fi
    if [ -f ~/.bashrc ]; then
      _BASH_RC_FILE_CACHE="$(readlink -f ~/.bashrc)"
      echo "$_BASH_RC_FILE_CACHE"
      return 0
    fi
    log "ERROR" "Bash config file not found"
    return 1
  fi
}

resolve_home_path() {
  local path="$1"

  case "$path" in
  "~") path="$HOME" ;;
  "~/"*) path="$HOME/${path#~/}" ;;
  "\$HOME/"*) path="$HOME/${path#\$HOME/}" ;;
  "\${HOME}/"*) path="$HOME/${path#\$\{HOME\}/}" ;;
  esac

  echo "$path"
}

get_completion_dir_from_rc() {
  local shell_type="$1"
  local rc_file="$2"
  local line=""
  local raw_path=""

  [ -f "$rc_file" ] || return 1

  if [ "$shell_type" = "zsh" ]; then
    line="$(grep -E '^[[:space:]]*fpath=\([^)]*\$fpath[^)]*\)' "$rc_file" | grep -v '^[[:space:]]*#' | head -n1 || true)"
    [ -n "$line" ] || return 1
    raw_path="$(echo "$line" | sed -E 's/^[[:space:]]*fpath=\(([\"\047]?)([^\"\047[:space:])]+).*/\2/')"
  else
    line="$(grep -E '^[[:space:]]*for[[:space:]]+file[[:space:]]+in[[:space:]]+.+/\*;[[:space:]]*do[[:space:]]+\.[[:space:]]+"?\$file"?;[[:space:]]*done' "$rc_file" | grep -v '^[[:space:]]*#' | head -n1 || true)"
    [ -n "$line" ] || return 1
    raw_path="$(echo "$line" | sed -E 's#^[[:space:]]*for[[:space:]]+file[[:space:]]+in[[:space:]]+(.+)/\*;[[:space:]]*do[[:space:]]+\.[[:space:]]+"?\$file"?;[[:space:]]*done#\1#')"
  fi

  raw_path="${raw_path%\"}"
  raw_path="${raw_path#\"}"
  raw_path="${raw_path%\'}"
  raw_path="${raw_path#\'}"
  raw_path="$(resolve_home_path "$raw_path")"

  [ -n "$raw_path" ] || return 1
  echo "$raw_path"
}

# Function to get the completion directory based on shell type
get_completion_dir() {
  local shell_type="$1"
  local cached_dir=""
  local rc_file=""
  local rc_completion_dir=""
  local default_dirname=""
  local base_dir=""

  # Always check for explicit environment variables first
  if [ "$shell_type" == "zsh" ] && [ -n "${ZSH_COMPLETION_DIR:-}" ]; then
    _ZSH_COMPLETION_DIR_CACHE="$ZSH_COMPLETION_DIR"
    echo "$_ZSH_COMPLETION_DIR_CACHE"
    return 0
  fi

  if [ "$shell_type" == "bash" ] && [ -n "${BASH_COMPLETION_DIR:-}" ]; then
    _BASH_COMPLETION_DIR_CACHE="$BASH_COMPLETION_DIR"
    echo "$_BASH_COMPLETION_DIR_CACHE"
    return 0
  fi

  # Infer from existing shell rc file configuration
  if rc_file="$(get_rc_file "$shell_type" 2>/dev/null)"; then
    rc_completion_dir="$(get_completion_dir_from_rc "$shell_type" "$rc_file" || true)"
    if [ -n "$rc_completion_dir" ]; then
      if [ "$shell_type" = "zsh" ]; then
        _ZSH_COMPLETION_DIR_CACHE="$rc_completion_dir"
      else
        _BASH_COMPLETION_DIR_CACHE="$rc_completion_dir"
      fi
      echo "$rc_completion_dir"
      return 0
    fi
  fi

  if [ "$shell_type" = "zsh" ]; then
    cached_dir="${_ZSH_COMPLETION_DIR_CACHE:-}"
  else
    cached_dir="${_BASH_COMPLETION_DIR_CACHE:-}"
  fi

  # Use per-shell cache when no custom dirname override is set
  if [ -n "$cached_dir" ] && [ -z "${COMPLETION_DIRNAME:-}" ]; then
    echo "$cached_dir"
    return 0
  fi

  if [ "$shell_type" = "zsh" ]; then
    default_dirname="zsh_completion.d"
  else
    default_dirname="bash_completion.d"
  fi

  # If user sets COMPLETION_DIRNAME, keep it as explicit override.
  if [ -n "${COMPLETION_DIRNAME:-}" ]; then
    default_dirname="$COMPLETION_DIRNAME"
  fi

  if base_dir="$(get_config_dir "$shell_type" 2>/dev/null)"; then
    :
  elif [ "$shell_type" = "zsh" ]; then
    base_dir="${XDG_CONFIG_HOME:-$HOME/.config}/zsh"
  elif [ -n "${XDG_CONFIG_HOME:-}" ]; then
    base_dir="$XDG_CONFIG_HOME"
  elif [ -d "$HOME/.config" ]; then
    base_dir="$HOME/.config"
  else
    base_dir="$HOME"
  fi

  cached_dir="$base_dir${base_dir:+/}${default_dirname}"
  if [ "$shell_type" = "zsh" ]; then
    _ZSH_COMPLETION_DIR_CACHE="$cached_dir"
  else
    _BASH_COMPLETION_DIR_CACHE="$cached_dir"
  fi
  echo "$cached_dir"
}

prompt_yes_no() {
  local prompt="$1"
  local default="${2:-Y}"
  local reply

  if [ ! -r /dev/tty ]; then
    [ "$default" = "Y" ]
    return $?
  fi

  while true; do
    read -r -p "$prompt" reply </dev/tty || reply=""
    reply="${reply:-$default}"
    case "$reply" in
    Y | y | yes | YES) return 0 ;;
    N | n | no | NO) return 1 ;;
    esac
  done
}

prompt_input() {
  local prompt="$1"
  local default="${2:-}"
  local reply

  if [ ! -r /dev/tty ]; then
    echo "$default"
    return 0
  fi

  read -r -p "$prompt" reply </dev/tty || reply=""
  echo "${reply:-$default}"
}

infer_shell_from_content() {
  local file="$1"

  if grep -qE '^[[:space:]]*#compdef|^[[:space:]]*compdef[[:space:]]' "$file"; then
    echo "zsh"
    return 0
  fi
  if grep -qE '^[[:space:]]*complete[[:space:]]' "$file"; then
    echo "bash"
    return 0
  fi
  return 1
}

infer_command_from_content() {
  local shell_type="$1"
  local file="$2"

  if [ "$shell_type" = "zsh" ]; then
    awk '
            /^[[:space:]]*#compdef[[:space:]]+/ {
                for (i=2; i<=NF; i++) {
                    if ($i !~ /^-/) { print $i; exit }
                }
            }
            /^[[:space:]]*compdef[[:space:]]+/ {
                cmd=""
                for (i=2; i<=NF; i++) {
                    if ($i !~ /^-/ && $i !~ /^_/) { cmd=$i }
                }
                if (cmd != "") { print cmd; exit }
            }
        ' "$file"
    return 0
  fi

  awk '
        /^[[:space:]]*complete[[:space:]]+/ {
            sub(/#.*/, "")
            print $NF
            exit
        }
    ' "$file"
}

handle_piped_stdin() {
  local tmp_file
  tmp_file="$(mktemp)"
  cat >"$tmp_file"

  local shell_type
  shell_type="$(infer_shell_from_content "$tmp_file" || true)"
  if [ -n "$shell_type" ]; then
    if ! prompt_yes_no "Detected shell: ${shell_type}. Use this? (Y/n) " "Y"; then
      shell_type=""
    fi
  fi
  if [ -z "$shell_type" ]; then
    shell_type="$(prompt_input "Shell (bash/zsh) [$(get_shell_type)]: " "$(get_shell_type)")"
  fi

  if [ "$shell_type" != "bash" ] && [ "$shell_type" != "zsh" ]; then
    log "ERROR" "Unsupported shell type: $shell_type. Use 'bash' or 'zsh'."
    rm -f "$tmp_file"
    return 1
  fi

  local cmd_name
  cmd_name="$(infer_command_from_content "$shell_type" "$tmp_file" || true)"

  local default_name=""
  if [ -n "$cmd_name" ]; then
    if [ "$shell_type" = "zsh" ]; then
      default_name="_$cmd_name"
    else
      default_name="$cmd_name"
    fi
  fi

  local completion_name
  if [ -n "$default_name" ]; then
    completion_name="$(prompt_input "Completion name [${default_name}]: " "$default_name")"
  else
    completion_name="$(prompt_input "Completion name: " "")"
  fi

  if [ -z "$completion_name" ]; then
    log "ERROR" "Completion name is required"
    rm -f "$tmp_file"
    return 1
  fi

  if [ "$shell_type" = "zsh" ] && [[ "$completion_name" != _* ]]; then
    if prompt_yes_no "Zsh completions usually start with '_'. Use '_${completion_name}'? (Y/n) " "Y"; then
      completion_name="_$completion_name"
    fi
  fi

  local completion_dir
  completion_dir="$(get_completion_dir "$shell_type")"
  if ! prompt_yes_no "Add ${completion_name} to ${completion_dir}? (Y/n) " "Y"; then
    log "INFO" "Aborted."
    rm -f "$tmp_file"
    return 1
  fi

  cat "$tmp_file" | add_completion_from_stdin "$completion_name" "$shell_type"
  rm -f "$tmp_file"
}

# Function to validate/lint completion files
lint_completions() {
  local shell_type="${1:-$(get_shell_type)}"
  local completion_dir
  completion_dir="$(get_completion_dir "$shell_type")"
  local errors_found=0

  echo -e "${_BLUE}=== Linting ${shell_type} completions in ${completion_dir} ===${_RESET}"
  echo ""

  if [ ! -d "$completion_dir" ]; then
    log "ERROR" "Completion directory does not exist: $completion_dir"
    return 1
  fi

  # Find all completion files
  for completion_file in "$completion_dir"/*; do
    [ -f "$completion_file" ] || continue
    [ -x "$completion_file" ] || continue

    local filename
    filename="$(basename "$completion_file")"
    echo -e "${_BLUE}Checking:${_RESET} ${_YELLOW}$filename${_RESET}"

    if [ "$shell_type" = "bash" ]; then
      lint_bash_completion "$completion_file"
      local_errors=$?
      errors_found=$((errors_found + local_errors))
    elif [ "$shell_type" = "zsh" ]; then
      lint_zsh_completion "$completion_file"
      local_errors=$?
      errors_found=$((errors_found + local_errors))
    fi

    echo ""
  done

  if [ "$errors_found" -eq 0 ]; then
    echo -e "${_GREEN}✅ All completions passed validation!${_RESET}"
  else
    echo -e "${_RED}❌ Found $errors_found issue(s)${_RESET}"
  fi

  return "$errors_found"
}

lint_bash_completion() {
  local file="$1"
  local filename
  filename="$(basename "$file")"
  local local_errors=0

  # Check for common bash completion issues
  if ! grep -q "complete.*$filename" "$file"; then
    echo -e "  ${_RED}✗${_RESET} Missing 'complete' registration for '$filename'" >&2
    local_errors=$((local_errors + 1))
  fi

  # Check for function definition
  if ! grep -q "_$filename()" "$file" 2>/dev/null; then
    local func_name
    func_name="_${filename%.*}" # Remove extension if present
    if ! grep -q "$func_name()" "$file"; then
      echo -e "  ${_RED}✗${_RESET} Missing completion function '$func_name()'" >&2
      local_errors=$((local_errors + 1))
    fi
  fi

  # Check for syntax errors
  if ! bash -n "$file" 2>/dev/null; then
    echo -e "  ${_RED}✗${_RESET} Bash syntax error in file" >&2
    local_errors=$((local_errors + 1))
  fi

  # Check for dangerous commands
  if grep -q -E "(rm -rf|dd if=|> /dev/null)" "$file"; then
    echo -e "  ${_YELLOW}⚠${_RESET}  Potentially dangerous commands found" >&2
    local_errors=$((local_errors + 1))
  fi

  if [ "$local_errors" -eq 0 ]; then
    echo -e "  ${_GREEN}✓${_RESET} Bash completion looks good"
  fi

  return "$local_errors"
}

lint_zsh_completion() {
  local file="$1"
  local filename
  filename="$(basename "$file")"
  local local_errors=0

  # Check for #compdef directive
  if ! grep -q "^#compdef" "$file"; then
    echo -e "  ${_RED}✗${_RESET} Missing '#compdef' directive" >&2
    local_errors=$((local_errors + 1))
  fi

  # Check for function definition
  if ! grep -q "_$filename()" "$file" 2>/dev/null; then
    local func_name
    func_name="_${filename%.*}" # Remove extension if present
    if ! grep -q "$func_name()" "$file"; then
      echo -e "  ${_RED}✗${_RESET} Missing completion function '$func_name()'" >&2
      local_errors=$((local_errors + 1))
    fi
  fi

  # Check for syntax errors
  if ! zsh -n "$file" 2>/dev/null; then
    echo -e "  ${_RED}✗${_RESET} Zsh syntax error in file" >&2
    local_errors=$((local_errors + 1))
  fi

  # Check for _arguments usage (proper zsh completion)
  if ! grep -q "_arguments" "$file" && grep -q "compadd"; then
    echo -e "  ${_YELLOW}⚠${_RESET}  Using compadd without _arguments (may be incomplete)" >&2
  fi

  # Check for dangerous commands
  if grep -q -E "(rm -rf|dd if=|> /dev/null)" "$file"; then
    echo -e "  ${_YELLOW}⚠${_RESET}  Potentially dangerous commands found" >&2
    local_errors=$((local_errors + 1))
  fi

  if [ "$local_errors" -eq 0 ]; then
    echo -e "  ${_GREEN}✓${_RESET} Zsh completion looks good"
  fi

  return "$local_errors"
}

# Function to generate completion script for specified shell
generate_completion_script() {
  local shell_type="$1"

  case "$shell_type" in
  bash)
    cat <<'BASH_EOF'
# Bash completion script generated by compliment
# Add this to your ~/.bashrc or source it directly

# Basic completion function template
_my_command() {
    local cur prev words cword
    _init_completion || return

    # Case to handle different subcommands
    case "${words[1]}" in
        subcommand1)
            # Complete options for subcommand1
            COMPREPLY=($(compgen -W "--help --verbose" -- "$cur"))
            ;;
        subcommand2)
            # Complete files for subcommand2
            COMPREPLY=($(compgen -f -- "$cur"))
            ;;
        *)
            # Default completion
            COMPREPLY=($(compgen -W "--help --version subcommand1 subcommand2" -- "$cur"))
            ;;
    esac
}

# Register the completion function
complete -F _my_command my_command
BASH_EOF
    ;;
  zsh)
    cat <<'ZSH_EOF'
#compdef my_command
# Zsh completion script generated by compliment

_my_command() {
    local -a commands
    local context state line

    # Define the available subcommands and options
    commands=(
        'subcommand1:Description of subcommand1'
        'subcommand2:Description of subcommand2'
        '--help:Show help message'
        '--version:Show version'
    )

    # Use _arguments to define completion behavior
    _arguments -C \
      '1: :->command' \
      '*::arg:->args' \
      && case $state in
            (command)
                _describe 'command' commands
                ;;
            (args)
                case $line[1] in
                    subcommand1)
                    _arguments '--help[Show help]' '--verbose[Verbose output]'
                    ;;
                    subcommand2)
                    _files
                    ;;
                    *)
                    _arguments '--help[Show help]' '--version[Show version]'
                    ;;
                esac
                ;;
        esac
}

# Register the completion function
_my_command "$@"
ZSH_EOF
    ;;
  *)
    log "ERROR" "Unsupported shell type: $shell_type. Use 'bash' or 'zsh'."
    return 1
    ;;
  esac
}

# Function to check if the script is sourced
sourced_p() {
  if [ -n "${BASH_SOURCE:-}" ]; then
    ! [[ "${BASH_SOURCE[0]}" == "${0}" ]]
  elif [ -n "${ZSH_VERSION:-}" ]; then
    # In zsh, $0 contains the script name even when sourced,
    # but $funcsourcetrace can be used to determine if sourced
    [ -n "${funcsourcetrace:-}" ]
  else
    # Fallback for other shells
    return 1
  fi
}

usage() {
  echo -e "${_BOLD}${_UNDERLINE}compliment - a tool for managing shell completions${_RESET}"
  echo -e "Usage: compliment ${_BLUE}compliment ${_YELLOW}[options]${_RESET}"
  echo -e "Options:"
  echo -e "  ${_YELLOW}--file${_RESET}    <file>        Add a completion file"
  echo -e "  ${_YELLOW}--command${_RESET} <cmd> <name>  Add a completion script"
  echo -e "                           from a commands output"
  echo -e "  ${_YELLOW}--stdin${_RESET}   <name>        Add a completion script through"
  echo -e "                           stdin from a commands output"
  echo -e "  (pipe)                       If stdin is piped and no options are given,"
  echo -e "                              prompt to infer shell and completion name"
  echo -e "  ${_YELLOW}--remove${_RESET}  <name>        Remove a completion script"
  echo -e "  ${_YELLOW}--list${_RESET}                  List completion scripts"
  echo -e "  ${_YELLOW}--reload${_RESET}                Reload shell completions"
  echo -e "  ${_YELLOW}--status${_RESET}                Show shell and completion status"
  echo -e "  ${_YELLOW}--chsh${_RESET}    <shell>       Set the shell type to <shell>"
  echo -e "                           (zsh or bash, default: login shell)"
  echo -e "  ${_YELLOW}completion${_RESET} <shell>        Output completion script for"
  echo -e "                           bash or zsh to stdout"
  echo -e "  ${_YELLOW}--lint${_RESET}                 Validate stored completion files"
  echo -e "  Default completion dir (bash): ~/.config/bash_completion.d"
  echo -e "  Default completion dir (zsh): ~/.config/zsh/zsh_completion.d"
  echo ""
}

# Logging function with enhanced error logging
log() {
  local level="$1"
  shift
  case "$level" in
  INFO) echo -e "${_BLUE}INFO:${_RESET}" "$@" >&2 ;;
  ERROR) echo -e "${_RED}ERROR:${_RESET}" "$@" >&2 ;;
  DEBUG)
    if [ "${DEBUG:-0}" -eq 1 ]; then
      echo -e "${_YELLOW}DEBUG:${_RESET}" "$@" >&2
    fi
    ;;
  esac
}
print_fpath() {
  zsh -c "echo \$fpath"
}
ensure_completion_loaded() {
  local type="${1:-zsh}"
  local filename="${2:-}"
  local completion_dir
  completion_dir="$(get_completion_dir "$type")"
  local autoload_cmd
  local block_begin="# >>> compliment completions >>>"
  local block_end="# <<< compliment completions <<<"
  local block_tmp

  # If filename is not provided, get it from get_rc_file
  if [ -z "$filename" ]; then
    # If we're in a test environment, do nothing to avoid modifying real RC files
    if [ -n "${BATS_TEST_FILENAME:-}" ]; then
      log "DEBUG" "Skipping completion loading in test environment"
      return 0
    else
      filename="$(get_rc_file "$type")"
      if [ $? -ne 0 ] || [ -z "$filename" ]; then
        log "ERROR" "Could not determine RC file for $type"
        return 1
      fi
    fi
  fi

  if [ "$type" == "zsh" ]; then
    # fpath="$(print_fpath)"
    autoload_cmd="fpath=($completion_dir \$fpath)"
    # if [ "$type" = "zsh" ]; then
    #   autoload_cmd="fpath=($completion_dir \$fpath)"
    block_tmp="$(mktemp)"
    {
      echo "$block_begin"
      echo "$autoload_cmd"
      echo "$block_end"
    } >"$block_tmp"

    if grep -qF "$block_begin" "$filename"; then
      log "DEBUG" "${type}>updating completion block in $filename"
      awk -v begin="$block_begin" -v end="$block_end" -v block_file="$block_tmp" '
                $0==begin { while ((getline l < block_file) > 0) print l; in_block=1; next }
                in_block { if ($0==end) in_block=0; next }
                { print }
            ' "$filename" >"$filename.tmp" && mv "$filename.tmp" "$filename"
      rm -f "$block_tmp"
      return 0
    fi

    if grep -qE "fpath=\\(.*(_completion|_completions).*\$fpath\\)" "$filename"; then
      log "DEBUG" "${type}>updating legacy completion line in $filename"
      awk -v re="fpath=\\(.*(_completion|_completions).*\$fpath\\)" -v block_file="$block_tmp" '
                $0 ~ re {
                    if (!replaced) {
                        while ((getline l < block_file) > 0) print l;
                        replaced=1
                    }
                    next
                }
                { print }
            ' "$filename" >"$filename.tmp" && mv "$filename.tmp" "$filename"
      rm -f "$block_tmp"
      return 0
    fi

    # Check if 'compinit' is already in the file
    if grep -q "compinit" "$filename"; then
      log "DEBUG" "${type}>inserting completion block in $filename"
      awk -v pattern="compinit" -v block_file="$block_tmp" '
                !inserted && $0 ~ pattern { while ((getline l < block_file) > 0) print l; inserted=1 }
                { print }
            ' "$filename" >"$filename.tmp" && mv "$filename.tmp" "$filename"
    else
      # Prepend the completion block and compinit if missing
      log "DEBUG" "${type}>prepending completion block to $filename"
      log "DEBUG" "${type}>autoload command: $autoload_cmd"
      {
        cat "$block_tmp"
        echo "autoload -Uz compinit"
        echo "compinit"
        cat "$filename"
      } >"$filename.tmp" && mv "$filename.tmp" "$filename"
    fi
    rm -f "$block_tmp"
  else
    autoload_cmd="for file in $completion_dir/*; do . \"\$file\"; done"
    block_tmp="$(mktemp)"
    {
      echo "$block_begin"
      echo "# bash_completion"
      echo "$autoload_cmd"
      echo "$block_end"
    } >"$block_tmp"

    if grep -qF "$block_begin" "$filename"; then
      log "DEBUG" "${type}>updating completion block in $filename"
      awk -v begin="$block_begin" -v end="$block_end" -v block_file="$block_tmp" '
                $0==begin { while ((getline l < block_file) > 0) print l; in_block=1; next }
                in_block { if ($0==end) in_block=0; next }
                { print }
            ' "$filename" >"$filename.tmp" && mv "$filename.tmp" "$filename"
      rm -f "$block_tmp"
      return 0
    fi

    if grep -qE "for file in .*(_completion|_completions).*/\\*; do \\. \"\$file\"; done" "$filename"; then
      log "DEBUG" "${type}>updating legacy completion line in $filename"
      awk -v re="for file in .*(_completion|_completions).*/\\*; do \\. \"\\$file\"; done" -v block_file="$block_tmp" '
                $0 ~ re {
                    if (!replaced) {
                        while ((getline l < block_file) > 0) print l;
                        replaced=1
                    }
                    next
                }
                { print }
            ' "$filename" >"$filename.tmp" && mv "$filename.tmp" "$filename"
      rm -f "$block_tmp"
      return 0
    fi

    log "DEBUG" "${type}>adding completion block to $filename"
    log "DEBUG" "${type}>autoload command: $autoload_cmd"
    cat "$block_tmp" >>"$filename"
    rm -f "$block_tmp"
  fi
}

reload_completions() {
  local type="${1:-${COMPL_SHELL:-$(get_shell_type)}}"
  local completion_dir
  completion_dir="$(get_completion_dir "$type")"

  if [ ! -d "$completion_dir" ]; then
    log "ERROR" "Completion directory does not exist: $completion_dir"
    return 1
  fi

  if [ "$type" == "zsh" ]; then
    autoload -Uz compinit && compinit
    log "INFO" "Zsh completions exiting && reloading"
    exec zsh
  else
    for file in "$completion_dir"/*; do
      [ -f "$file" ] && . "$file"
    done
    log "INFO" "Bash completions reloaded"
  fi
}

show_status() {
  echo -e "${_BOLD}${_BLUE}=== Compliment Status Report ===${_RESET}"
  echo ""

  # Show active shell information
  local active_shell
  active_shell="$(get_shell_type)"
  echo -e "${_BOLD}Active Shell:${_RESET} ${_GREEN}$active_shell${_RESET}"

  # Show config for both shells
  local shells=("bash" "zsh")
  for shell in "${shells[@]}"; do
    echo ""
    echo -e "${_BOLD}=== $shell Configuration ===${_RESET}"

    local config_dir
    config_dir="$(get_config_dir "$shell" 2>/dev/null || echo "Not found")"
    echo "Config Directory: $config_dir"

    local rc_file
    rc_file="$(get_rc_file "$shell" 2>/dev/null || echo "Not found")"
    echo "RC File: $rc_file"

    local completion_dir
    completion_dir="$(get_completion_dir "$shell" 2>/dev/null || echo "Not determined")"
    echo "Completion Directory: $completion_dir"

    # Count completions
    if [ -d "$completion_dir" ]; then
      local completion_count
      completion_count=$(find "$completion_dir" -maxdepth 1 -type f | wc -l)
      echo -e "Completions: ${_GREEN}$completion_count${_RESET}"

      # List some examples if directory isn't empty
      if [ "$completion_count" -gt 0 ]; then
        echo "Examples:"
        find "$completion_dir" -maxdepth 1 -type f -not -name ".*" | head -5 | while read -r file; do
          echo "  - $(basename "$file")"
        done
        if [ "$completion_count" -gt 5 ]; then
          echo "  ... and $((completion_count - 5)) more"
        fi
      fi
    else
      echo -e "Completions: ${_YELLOW}Directory does not exist${_RESET}"
    fi
  done

  echo ""
  echo -e "${_BOLD}Environment Variables:${_RESET}"
  echo "COMPLETION_DIRNAME: ${COMPLETION_DIRNAME:-<not set>}"
  echo "BASH_COMPLETION_DIR: ${BASH_COMPLETION_DIR:-<not set>}"
  echo "ZSH_COMPLETION_DIR: ${ZSH_COMPLETION_DIR:-<not set>}"

  echo ""
  echo -e "${_BOLD}Note:${_RESET} Use --chsh to override shell detection"
}

add_completion_from_file() {
  local filepath="$1"
  local shell_type=""
  local name=""

  # Handle both calling conventions:
  # Old: add_completion_from_file filepath shell_type
  # New: add_completion_from_file filepath name shell_type
  if [ "$#" -eq 2 ]; then
    shell_type="$2"
    name="$(basename "$filepath")"
  else
    name="${2:-$(basename "$filepath")}"
    shell_type="${3:-${COMPL_SHELL:-$(get_shell_type)}}"
  fi

  local completion_dir

  completion_dir="$(get_completion_dir "$shell_type")"
  log "DEBUG" "Adding file to completion directory: $completion_dir"

  # Create completion directory if it doesn't exist
  if [ ! -d "$completion_dir" ]; then
    mkdir -p "$completion_dir"
    log "INFO" "Created completion directory: $completion_dir"
  fi

  if [ -f "$filepath" ]; then
    cp "$filepath" "$completion_dir/$name"
    log "INFO" "Added '$name' to $completion_dir"
  else
    log "ERROR" "Invalid file path provided: $filepath"
    return 1
  fi
}

