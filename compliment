add_completion_from_command() {
    local cmd="$1"
    local name="$2"
    local type="${3:-${COMPL_SHELL:-$(get_shell_type)}}"
    local completion_dir

    completion_dir="$(get_completion_dir "$type")"
    log "DEBUG" "Adding command output to completion directory: $completion_dir"

    # Create completion directory if it doesn't exist
    if [ ! -d "$completion_dir" ]; then
        mkdir -p "$completion_dir"
        log "INFO" "Created completion directory: $completion_dir"
    fi

    if [ "$cmd" == "-" ]; then
        cat >"$completion_dir/$name"
    else
        # Safer command execution with error checking does not work unfortunately(?)
        # if bash -c $(printf "%q" "$cmd") >"$completion_dir/$name"; then
        if bash -c "$cmd" >"$completion_dir/$name"; then
            log "INFO" "Added completion script '$name' from command to $completion_dir"
        else
            log "ERROR" "Failed to execute command: $cmd"
            log "ERROR" "$(ls -l "$(dirname "$cmd")" 2>/dev/null || echo "Command directory not accessible")"
            return 1
        fi
    fi
}

